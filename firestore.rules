rules_version = '2';
// AI Marg: each signed-in learner may read, write and delete only their own progress document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /progress/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['state', 'v', 'updatedAt'])
        && request.resource.data.state is string
        && request.resource.data.state.size() < 950000;
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
